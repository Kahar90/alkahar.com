---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Uses — Nabil Alkahar">
  <h1 class="text-2xl font-bold mb-4">Uses</h1>
  <p class="text-muted mb-8">
    Tools I use daily.
  </p>

  <hr />

  <section class="mb-8">
    <h2 class="text-sm font-bold uppercase tracking-wider mb-4 text-muted">Hardware</h2>
    <ul class="list-disc pl-5 space-y-1">
      <li>ThinkPad X1 Carbon</li>
      <li>Logitech MX Master 4 <span class="text-muted">— genuinely so good, makes it tolerable working anywhere</span></li>
      <li>Keychron K3</li>
    </ul>
  </section>
</Layout>
