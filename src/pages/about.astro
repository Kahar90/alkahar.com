---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="About — Nabil Alkahar">
  <h1 class="text-2xl font-bold mb-4">About</h1>
  <p class="text-muted mb-8">
    Software engineer turned solutions architect. I bridge business requirements and technical reality.
  </p>

  <hr />

  <section class="mb-12">
    <h2 class="text-sm font-bold uppercase tracking-wider mb-6 text-muted">Experience</h2>

    <div class="space-y-8">
      <div>
        <div class="flex justify-between items-baseline mb-1">
          <h3 class="font-bold">Solutions Architect</h3>
          <span class="text-sm text-muted">2025 &mdash; Present</span>
        </div>
        <p class="text-sm text-muted mb-2">Huawei &middot; Jakarta, Indonesia &middot; On-site</p>
        <p>
          Architecting and delivering secure, scalable solutions on Huawei Cloud that translate
          complex business requirements into technical reality.
        </p>
      </div>

      <div>
        <div class="flex justify-between items-baseline mb-1">
          <h3 class="font-bold">Software Engineer</h3>
          <span class="text-sm text-muted">2022 &mdash; 2025</span>
        </div>
        <p class="text-sm text-muted mb-2">Lizard Global &middot; Remote &middot; Kuala Lumpur, Malaysia</p>
        <p>
          Crafted beautiful, functional, and high-performance applications for visionary clients.
          Worked with Next.js, Apollo GraphQL, and modern web technologies.
        </p>
      </div>

      <div>
        <div class="flex justify-between items-baseline mb-1">
          <h3 class="font-bold">Software Engineer Intern</h3>
          <span class="text-sm text-muted">2022</span>
        </div>
        <p class="text-sm text-muted mb-2">Lizard Global &middot; Kuala Lumpur, Malaysia</p>
        <p>
          Built foundational skills in full-stack development, contributing to production codebases
          and learning agile engineering practices.
        </p>
      </div>
    </div>
  </section>

  <hr />

  <section>
    <h2 class="text-sm font-bold uppercase tracking-wider mb-6 text-muted">Skills</h2>
    <p>
      Cloud Architecture, Solution Design, Next.js, React, TypeScript, Apollo GraphQL,
      Node.js, Software Development, System Design, Interpersonal Communication.
    </p>
  </section>
</Layout>
