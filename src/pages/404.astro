---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 — Nabil Alkahar">
  <div class="text-center">
    <pre class="text-base leading-relaxed mb-8" style="color: var(--muted);">
      /\___/\
     (  ^.^  )
      >  ^  <
     (_______)
    </pre>

    <h1 class="text-2xl font-bold mb-4">404</h1>
    <p class="text-muted mb-8">
      you wandered off the map.
      the cat is judging you.
    </p>

    <a href="/" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">
      [return home]
    </a>
  </div>
</Layout>

<style>
  pre {
    user-select: none;
  }
</style>
