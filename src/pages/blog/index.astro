---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<Layout title="Blog — Nabil Alkahar">
  <h1 class="text-2xl font-bold mb-4">Blog</h1>
  <p class="text-muted mb-8">
    Thoughts on engineering, cloud architecture, and building things that matter.
  </p>

  <hr />

  {posts.length === 0 ? (
    <p class="text-muted">No posts yet. Check back soon.</p>
  ) : (
    <ul class="space-y-8">
      {posts.map((post) => (
        <li>
          <article>
            <div class="flex justify-between items-baseline mb-1">
              <h2 class="font-bold">
                <a href={`/blog/${post.slug}/`} class="no-underline hover:underline">
                  {post.data.title}
                </a>
              </h2>
              <time class="text-sm text-muted shrink-0 ml-4" datetime={post.data.date}>
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>
            {post.data.excerpt && (
              <p class="text-muted text-sm">{post.data.excerpt}</p>
            )}
          </article>
        </li>
      ))}
    </ul>
  )}
</Layout>
