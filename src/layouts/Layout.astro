---
import { ViewTransitions } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Personal website of Nabil Alkahar', wide = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <ViewTransitions />
    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen font-mono transition-colors duration-300">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100001] focus:px-4 focus:py-2 focus:bg-fg focus:text-bg">
      Skip to content
    </a>
    <div class={wide ? 'w-full px-6 py-12' : 'max-w-[65ch] mx-auto px-6 py-12'}>
      <header class="mb-12 flex flex-wrap justify-between items-center gap-y-3">
        <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          <a href="/" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>home</a>
          <a href="/about" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>about</a>
          <a href="/blog" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>blog</a>
          <a href="/uses" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg" aria-current={Astro.url.pathname === '/uses/' ? 'page' : undefined}>uses</a>
          <a href="/gallery" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg" aria-current={Astro.url.pathname === '/gallery/' ? 'page' : undefined}>gallery</a>
        </nav>
        <button
          id="theme-toggle"
          class="text-accent cursor-pointer bg-transparent border-none font-mono p-1 leading-none"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class={wide ? 'max-w-[65ch] mx-auto mt-24 pt-6 border-t border-neutral-200 text-sm text-muted' : 'mt-24 pt-6 border-t border-neutral-200 text-sm text-muted'}>
        <p>&copy; {new Date().getFullYear()} Nabil Alkahar. All rights reserved.</p>
        <p class="text-xs mt-1" style="color: var(--muted);">
          Last updated: {new Date().toLocaleString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}
        </p>
        <div id="cat-floor" aria-hidden="true">
          <div id="wandering-cat">
            <div id="meow-bubble" class="meow-bubble"></div>
            <pre id="wandering-cat-art"></pre>
          </div>
        </div>
      </footer>
    </div>

    <div id="easter-egg" class="easter-egg" style="display: none;" role="dialog" aria-modal="true" aria-label="Secret terminal" tabindex="-1">
      <div class="easter-egg-backdrop"></div>
      <div class="easter-egg-terminal">
        <div class="easter-egg-header">
          <span class="easter-egg-dot" style="background:#ff5f57;"></span>
          <span class="easter-egg-dot" style="background:#febc2e;"></span>
          <span class="easter-egg-dot" style="background:#28c840;"></span>
          <span class="easter-egg-title">terminal — alkahar-com.vercel.app</span>
        </div>
        <div class="easter-egg-body">
          <pre class="easter-egg-output" id="easter-egg-output"></pre>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  (function () {
    var toggleHandler = null;

    function applyTheme() {
      var theme = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var html = document.documentElement;
      if (theme === 'dark' || (!theme && prefersDark)) {
        html.classList.add('dark');
      } else {
        html.classList.remove('dark');
      }
    }

    function updateIcons() {
      var sun = document.getElementById('icon-sun');
      var moon = document.getElementById('icon-moon');
      if (!sun || !moon) return;
      var isDark = document.documentElement.classList.contains('dark');
      sun.style.display = isDark ? 'block' : 'none';
      moon.style.display = isDark ? 'none' : 'block';
    }

    function initToggle() {
      var toggle = document.getElementById('theme-toggle');
      if (!toggle) return;

      updateIcons();

      if (toggleHandler) {
        toggle.removeEventListener('click', toggleHandler);
      }

      toggleHandler = function () {
        var html = document.documentElement;
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        updateIcons();
      };

      toggle.addEventListener('click', toggleHandler);
    }

    document.addEventListener('astro:before-swap', function (ev) {
      var theme = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        ev.newDocument.documentElement.classList.add('dark');
      } else {
        ev.newDocument.documentElement.classList.remove('dark');
      }
    });

    document.addEventListener('astro:page-load', function () {
      applyTheme();
      initToggle();
    });
  })();
</script>

<script>
(function () {
  var CURSOR_KEY = 'cursor-trail';
  var trailOn = localStorage.getItem(CURSOR_KEY) !== 'off';
  var dots = [];
  var mousemoveHandler = null;
  var keydownHandler = null;

  function enableTrail() {
    trailOn = true;
    localStorage.setItem(CURSOR_KEY, 'on');
  }

  function disableTrail() {
    trailOn = false;
    localStorage.removeItem(CURSOR_KEY);
    dots.forEach(function (d) { d.remove(); });
    dots = [];
  }

  function cleanupTrail() {
    if (mousemoveHandler) {
      document.removeEventListener('mousemove', mousemoveHandler);
      mousemoveHandler = null;
    }
    if (keydownHandler) {
      document.removeEventListener('keydown', keydownHandler);
      keydownHandler = null;
    }
    dots.forEach(function (d) { d.remove(); });
    dots = [];
  }

  function initTrail() {
    cleanupTrail();

    mousemoveHandler = function (e) {
      if (!trailOn) return;
      var dot = document.createElement('span');
      dot.textContent = '·';
      dot.style.cssText = 'position:fixed;left:' + e.clientX + 'px;top:' + e.clientY + 'px;pointer-events:none;z-index:99999;color:var(--muted);opacity:0.5;font-size:0.875rem;transition:opacity 1s ease-out,transform 1s ease-out;';
      document.body.appendChild(dot);
      dots.push(dot);

      requestAnimationFrame(function () {
        dot.style.opacity = '0';
        dot.style.transform = 'translateY(8px)';
      });

      setTimeout(function () {
        dot.remove();
        dots = dots.filter(function (d) { return d !== dot; });
      }, 1100);

      if (dots.length > 40) {
        var old = dots.shift();
        old?.remove();
      }
    };

    keydownHandler = function (e) {
      if (e.ctrlKey && e.shiftKey && e.key === 'T') {
        e.preventDefault();
        if (trailOn) {
          disableTrail();
        } else {
          enableTrail();
        }
      }
    };

    document.addEventListener('mousemove', mousemoveHandler);
    document.addEventListener('keydown', keydownHandler);
  }

  document.addEventListener('astro:before-swap', cleanupTrail);
  document.addEventListener('astro:page-load', initTrail);

  if (document.readyState !== 'loading') {
    initTrail();
  }
})();
</script>

<script>
(function () {
  var KONAMI = [
    'ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown',
    'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight',
    'KeyB', 'KeyA'
  ];

  var SECRET = `
$ whoami
nabil_alkahar

$ cat /etc/motd
┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃   ☆  ACCESS GRANTED — LEVEL 9  ☆        ┃
┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

$ ls -la ~/secrets/
drwx------  .classified/
  ├── kopi_rating_tokyo........98/100
  ├── best_viewpoint_jakarta...downtown at dusk
  ├── why_architects_smile.....because we saw the stack trace
  └── source_code..............thoughtfully over-engineered

$ fortune
"Technology is best when it brings people together."
  — Matt Mullenweg

"Also: clean code > clever code."

$ exit
  `.trim();

  var konamiIndex = 0;
  var typewriterTimer = null;
  var focusTrapHandler = null;
  var lastFocusedElement = null;

  document.addEventListener('keydown', function handler(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

    if (e.code === KONAMI[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === KONAMI.length) {
        konamiIndex = 0;
        triggerEasterEgg();
      }
    } else {
      konamiIndex = 0;
      if (e.code === KONAMI[0]) konamiIndex = 1;
    }
  });

  function getFocusable(container) {
    return container.querySelectorAll('a[href], button, textarea, input, select, [tabindex]:not([tabindex="-1"])');
  }

  function trapFocus(e) {
    var overlay = document.getElementById('easter-egg');
    if (!overlay) return;
    var focusable = Array.from(getFocusable(overlay));
    if (focusable.length === 0) {
      e.preventDefault();
      return;
    }
    var first = focusable[0];
    var last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  function triggerEasterEgg() {
    var overlay = document.getElementById('easter-egg');
    var output = document.getElementById('easter-egg-output');
    if (!overlay || !output) return;

    lastFocusedElement = document.activeElement;
    overlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    output.textContent = '';

    overlay.focus();

    if (focusTrapHandler) {
      overlay.removeEventListener('keydown', focusTrapHandler);
    }
    focusTrapHandler = trapFocus;
    overlay.addEventListener('keydown', focusTrapHandler);

    var i = 0;
    clearInterval(typewriterTimer);
    typewriterTimer = setInterval(function () {
      if (i < SECRET.length) {
        output.textContent += SECRET[i];
        i++;
      } else {
        clearInterval(typewriterTimer);
      }
    }, 25);
  }

  function closeEasterEgg() {
    var overlay = document.getElementById('easter-egg');
    if (!overlay) return;
    overlay.style.display = 'none';
    document.body.style.overflow = '';
    clearInterval(typewriterTimer);
    if (focusTrapHandler) {
      overlay.removeEventListener('keydown', focusTrapHandler);
      focusTrapHandler = null;
    }
    if (lastFocusedElement) {
      lastFocusedElement.focus();
      lastFocusedElement = null;
    }
  }

  document.getElementById('easter-egg')?.querySelector('.easter-egg-backdrop')?.addEventListener('click', closeEasterEgg);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.getElementById('easter-egg')?.style.display === 'flex') {
      closeEasterEgg();
    }
  });
})();
</script>

<script>
(function () {
  var tickTimer = null;
  var idleTimer = null;
  var blinkTimer = null;
  var clickHandler = null;
  var resizeHandler = null;

  function cleanupCat() {
    if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
    if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    if (blinkTimer) { clearInterval(blinkTimer); blinkTimer = null; }
    if (clickHandler) {
      var oldArt = document.getElementById('wandering-cat-art');
      if (oldArt) oldArt.removeEventListener('click', clickHandler);
      clickHandler = null;
    }
    if (resizeHandler) {
      window.removeEventListener('resize', resizeHandler);
      resizeHandler = null;
    }
  }

  function initCat() {
    cleanupCat();

    var cat = document.getElementById('wandering-cat');
    var artEl = document.getElementById('wandering-cat-art');
    var bubble = document.getElementById('meow-bubble');
    var floor = document.getElementById('cat-floor');
    if (!cat || !artEl || !bubble || !floor) return;

    var FRAMES = {
      stand: ' /\\_/\\ \n( o.o )\n > ^ < ',
      left:  ' /\\_/\\ \n( o.o )\n/   <  ',
      right: ' /\\_/\\ \n( o.o )\n >   \\ '
    };

    var posX = 20;
    var facingRight = true;
    var isWalking = false;
    var frameIndex = 0;
    var walkSequence = ['stand', 'left', 'stand', 'right'];

    function getMaxX() {
      return floor.offsetWidth - 70;
    }

    function setFrame(name) {
      artEl.textContent = FRAMES[name];
    }

    function setPos() {
      var scaleX = facingRight ? 1 : -1;
      cat.style.transform = 'translateX(' + posX + 'px) scaleX(' + scaleX + ')';
    }

    function clamp(val, min, max) {
      return Math.max(min, Math.min(max, val));
    }

    function startWalking() {
      if (isWalking) return;
      isWalking = true;
      frameIndex = 0;
      setFrame(walkSequence[frameIndex]);

      tickTimer = setInterval(function () {
        frameIndex = (frameIndex + 1) % 4;
        var frameName = walkSequence[frameIndex];
        setFrame(frameName);

        var step = 10;
        if (!facingRight) step = -step;
        posX += step;

        var maxX = getMaxX();
        if (posX > maxX) {
          posX = maxX;
          facingRight = false;
        } else if (posX < 0) {
          posX = 0;
          facingRight = true;
        }

        setPos();

        if (Math.random() < 0.15) {
          stopWalking();
        }
      }, 280);
    }

    function stopWalking() {
      isWalking = false;
      if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
      setFrame('stand');
      scheduleNextWalk();
    }

    function scheduleNextWalk() {
      var delay = Math.random() * 3000 + 2000;
      idleTimer = setTimeout(function () {
        if (Math.random() < 0.5) facingRight = !facingRight;
        startWalking();
      }, delay);
    }

    function blink() {
      if (isWalking) return;
      artEl.textContent = ' /\\_/\\ \n( -.o )\n > ^ < ';
      setTimeout(function () {
        if (!isWalking) setFrame('stand');
      }, 200);
    }

    setPos();
    setFrame('stand');
    scheduleNextWalk();
    blinkTimer = setInterval(blink, 4000);

    var lastClick = 0;
    clickHandler = function (e) {
      e.stopPropagation();
      var now = Date.now();
      if (now - lastClick < 2000) return;
      if (Math.random() > 0.3) return;
      lastClick = now;

      if (Math.random() < 0.5) {
        bubble.textContent = 'mew!';
        bubble.classList.add('show');
        setTimeout(function () { bubble.classList.remove('show'); }, 1400);
      } else {
        cat.style.transition = 'transform 0.15s ease-out';
        cat.style.transform = 'translateX(' + posX + 'px) scaleX(' + (facingRight ? 1 : -1) + ') translateY(-20px)';
        setTimeout(function () {
          cat.style.transition = 'transform 0.15s ease-in';
          setPos();
        }, 150);
      }
    };
    artEl.addEventListener('click', clickHandler);

    resizeHandler = function () {
      posX = clamp(posX, 0, getMaxX());
      setPos();
    };
    window.addEventListener('resize', resizeHandler);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCat);
  } else {
    initCat();
  }

  document.addEventListener('astro:page-load', initCat);
})();
</script>

<style is:global>
  :root {
    --fg: #111111;
    --bg: #fafafa;
    --muted: #666666;
    --accent: #2563eb;
    --border: #e5e5e5;
    --code-bg: #f0f0f0;
  }

  html.dark {
    --fg: #e5e5e5;
    --bg: #111111;
    --muted: #999999;
    --accent: #60a5fa;
    --border: #333333;
    --code-bg: #1a1a1a;
  }

  body {
    color: var(--fg);
    background-color: var(--bg);
  }

  .text-fg { color: var(--fg); }
  .bg-bg { background-color: var(--bg); }
  .text-muted { color: var(--muted); }
  .text-accent { color: var(--accent); }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    color: var(--fg);
  }
  .prose h1 { font-size: 1.5rem; }
  .prose h2 { font-size: 1.25rem; }
  .prose h3 { font-size: 1.125rem; }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--fg);
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--fg);
  }
  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 2px solid var(--fg);
    padding-left: 1rem;
    margin-bottom: 1.25rem;
    font-style: italic;
    color: var(--fg);
  }

  .prose code {
    background: var(--code-bg);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .prose pre {
    background: var(--code-bg);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose a {
    color: var(--accent);
  }

  .prose strong {
    color: var(--fg);
  }

  footer {
    border-color: var(--border) !important;
  }

  .easter-egg {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .easter-egg-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    cursor: pointer;
  }

  .easter-egg-terminal {
    position: relative;
    z-index: 1;
    width: min(90vw, 680px);
    background: #0a0a0a;
    border: 1px solid #333;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
  }

  .easter-egg-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: #1a1a1a;
    border-bottom: 1px solid #333;
  }

  .easter-egg-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .easter-egg-title {
    margin-left: 8px;
    font-size: 0.75rem;
    color: #666;
  }

  .easter-egg-body {
    padding: 16px 20px;
    min-height: 280px;
    max-height: 60vh;
    overflow-y: auto;
  }

  .easter-egg-output {
    color: #b3ffb3;
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
    min-height: 260px;
  }

  .easter-egg-output::after {
    content: '█';
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media print {
    header, nav, footer, button#theme-toggle {
      display: none !important;
    }

    body {
      color: #111111;
      background: #ffffff;
      font-size: 12pt;
      line-height: 1.6;
    }

    .max-w-\[65ch\] {
      max-width: none !important;
    }

    body > div {
      max-width: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    a {
      color: #111111;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    a[href^="http"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #666666;
    }

