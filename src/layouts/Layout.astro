---
export interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Personal website of Nabil Alkahar', wide = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen font-mono transition-colors duration-300">
    <div class={wide ? 'w-full px-6 py-12' : 'max-w-[65ch] mx-auto px-6 py-12'}>
      <header class="mb-12 flex justify-between items-center">
        <nav class="flex gap-6 text-sm">
          <a href="/" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">home</a>
          <a href="/about" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">about</a>
          <a href="/blog" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">blog</a>
          <a href="/gallery" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">gallery</a>
        </nav>
        <button
          id="theme-toggle"
          class="text-sm text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg cursor-pointer bg-transparent border-none font-mono"
          aria-label="Toggle dark mode"
        >
          [theme]
        </button>
      </header>
      <main>
        <slot />
      </main>
      <footer class={wide ? 'max-w-[65ch] mx-auto mt-24 pt-6 border-t border-neutral-200 text-sm text-muted' : 'mt-24 pt-6 border-t border-neutral-200 text-sm text-muted'}>
        <p>&copy; {new Date().getFullYear()} Nabil Alkahar. All rights reserved.</p>
        <p class="text-xs mt-1" style="color: var(--muted);">
          Last updated: {new Date().toLocaleString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}
        </p>
      </footer>
    </div>

    <div id="easter-egg" class="easter-egg" style="display: none;">
      <div class="easter-egg-backdrop"></div>
      <div class="easter-egg-terminal">
        <div class="easter-egg-header">
          <span class="easter-egg-dot" style="background:#ff5f57;"></span>
          <span class="easter-egg-dot" style="background:#febc2e;"></span>
          <span class="easter-egg-dot" style="background:#28c840;"></span>
          <span class="easter-egg-title">terminal — nabilalkahar.com</span>
        </div>
        <div class="easter-egg-body">
          <pre class="easter-egg-output" id="easter-egg-output"></pre>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  toggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
</script>

<script>
  const KONAMI = [
    'ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown',
    'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight',
    'KeyB', 'KeyA'
  ];

  const SECRET = `
$ whoami
nabil_alkahar

$ cat /etc/motd
┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃   ☆  ACCESS GRANTED — LEVEL 9  ☆        ┃
┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

$ ls -la ~/secrets/
drwx------  .classified/
  ├── kopi_rating_tokyo........98/100
  ├── best_viewpoint_jakarta...downtown at dusk
  ├── why_architects_smile.....because we saw the stack trace
  └── source_code..............thoughtfully over-engineered

$ fortune
"Technology is best when it brings people together."
  — Matt Mullenweg

"Also: clean code > clever code."

$ exit
  `.trim();

  let konamiIndex = 0;
  let typewriterTimer = null;

  document.addEventListener('keydown', function handler(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

    if (e.code === KONAMI[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === KONAMI.length) {
        konamiIndex = 0;
        triggerEasterEgg();
      }
    } else {
      konamiIndex = 0;
      if (e.code === KONAMI[0]) konamiIndex = 1;
    }
  });

  function triggerEasterEgg() {
    const overlay = document.getElementById('easter-egg');
    const output = document.getElementById('easter-egg-output');
    if (!overlay || !output) return;

    overlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    output.textContent = '';

    let i = 0;
    clearInterval(typewriterTimer);
    typewriterTimer = setInterval(() => {
      if (i < SECRET.length) {
        output.textContent += SECRET[i];
        i++;
      } else {
        clearInterval(typewriterTimer);
      }
    }, 25);
  }

  function closeEasterEgg() {
    const overlay = document.getElementById('easter-egg');
    if (!overlay) return;
    overlay.style.display = 'none';
    document.body.style.overflow = '';
    clearInterval(typewriterTimer);
  }

  document.getElementById('easter-egg')?.querySelector('.easter-egg-backdrop')?.addEventListener('click', closeEasterEgg);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.getElementById('easter-egg')?.style.display === 'flex') {
      closeEasterEgg();
    }
  });
</script>

<style is:global>
  :root {
    --fg: #111111;
    --bg: #fafafa;
    --muted: #666666;
    --accent: #2563eb;
    --border: #e5e5e5;
    --code-bg: #f0f0f0;
  }

  html.dark {
    --fg: #e5e5e5;
    --bg: #111111;
    --muted: #999999;
    --accent: #60a5fa;
    --border: #333333;
    --code-bg: #1a1a1a;
  }

  body {
    color: var(--fg);
    background-color: var(--bg);
  }

  .text-fg { color: var(--fg); }
  .bg-bg { background-color: var(--bg); }
  .text-muted { color: var(--muted); }
  .text-accent { color: var(--accent); }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    color: var(--fg);
  }
  .prose h1 { font-size: 1.5rem; }
  .prose h2 { font-size: 1.25rem; }
  .prose h3 { font-size: 1.125rem; }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--fg);
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--fg);
  }
  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 2px solid var(--fg);
    padding-left: 1rem;
    margin-bottom: 1.25rem;
    font-style: italic;
    color: var(--fg);
  }

  .prose code {
    background: var(--code-bg);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .prose pre {
    background: var(--code-bg);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose a {
    color: var(--accent);
  }

  .prose strong {
    color: var(--fg);
  }

  footer {
    border-color: var(--border) !important;
  }

  .easter-egg {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .easter-egg-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    cursor: pointer;
  }

  .easter-egg-terminal {
    position: relative;
    z-index: 1;
    width: min(90vw, 680px);
    background: #0a0a0a;
    border: 1px solid #333;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
  }

  .easter-egg-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: #1a1a1a;
    border-bottom: 1px solid #333;
  }

  .easter-egg-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .easter-egg-title {
    margin-left: 8px;
    font-size: 0.75rem;
    color: #666;
  }

  .easter-egg-body {
    padding: 16px 20px;
    min-height: 280px;
    max-height: 60vh;
    overflow-y: auto;
  }

  .easter-egg-output {
    color: #b3ffb3;
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
    min-height: 260px;
  }

  .easter-egg-output::after {
    content: '█';
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
