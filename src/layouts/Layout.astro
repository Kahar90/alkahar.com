---
export interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Personal website of Nabil Alkahar', wide = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen font-mono transition-colors duration-300">
    <div class={wide ? 'w-full px-6 py-12' : 'max-w-[65ch] mx-auto px-6 py-12'}>
      <header class="mb-12 flex justify-between items-center">
        <nav class="flex gap-6 text-sm">
          <a href="/" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">home</a>
          <a href="/about" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">about</a>
          <a href="/blog" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">blog</a>
          <a href="/uses" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">uses</a>
          <a href="/gallery" class="text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg">gallery</a>
        </nav>
        <button
          id="theme-toggle"
          class="text-sm text-accent underline underline-offset-2 hover:no-underline hover:bg-fg hover:text-bg cursor-pointer bg-transparent border-none font-mono"
          aria-label="Toggle dark mode"
        >
          [theme]
        </button>
      </header>
      <main>
        <slot />
      </main>
      <footer class={wide ? 'max-w-[65ch] mx-auto mt-24 pt-6 border-t border-neutral-200 text-sm text-muted' : 'mt-24 pt-6 border-t border-neutral-200 text-sm text-muted'}>
        <p>&copy; {new Date().getFullYear()} Nabil Alkahar. All rights reserved.</p>
        <p class="text-xs mt-1" style="color: var(--muted);">
          Last updated: {new Date().toLocaleString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}
        </p>
      </footer>
    </div>
  </body>
</html>

<script>
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  toggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
</script>

<script>
  const CURSOR_KEY = 'cursor-trail';
  let trailOn = localStorage.getItem(CURSOR_KEY) !== 'off';
  let dots = [];

  function enableTrail() {
    trailOn = true;
    localStorage.setItem(CURSOR_KEY, 'on');
  }

  function disableTrail() {
    trailOn = false;
    localStorage.removeItem(CURSOR_KEY);
    dots.forEach(d => d.remove());
    dots = [];
  }

  document.addEventListener('mousemove', function(e) {
    if (!trailOn) return;
    const dot = document.createElement('span');
    dot.textContent = '·';
    dot.style.cssText = `
      position: fixed;
      left: ${e.clientX}px;
      top: ${e.clientY}px;
      pointer-events: none;
      z-index: 99999;
      color: var(--muted);
      opacity: 0.5;
      font-size: 0.875rem;
      transition: opacity 1s ease-out, transform 1s ease-out;
    `;
    document.body.appendChild(dot);
    dots.push(dot);

    requestAnimationFrame(() => {
      dot.style.opacity = '0';
      dot.style.transform = 'translateY(8px)';
    });

    setTimeout(() => {
      dot.remove();
      dots = dots.filter(d => d !== dot);
    }, 1100);

    if (dots.length > 40) {
      const old = dots.shift();
      old?.remove();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'T') {
      e.preventDefault();
      if (trailOn) {
        disableTrail();
      } else {
        enableTrail();
      }
      console.log('Cursor trail: ' + (trailOn ? 'on' : 'off'));
    }
  });
</script>

<style is:global>
  :root {
    --fg: #111111;
    --bg: #fafafa;
    --muted: #666666;
    --accent: #2563eb;
    --border: #e5e5e5;
    --code-bg: #f0f0f0;
  }

  html.dark {
    --fg: #e5e5e5;
    --bg: #111111;
    --muted: #999999;
    --accent: #60a5fa;
    --border: #333333;
    --code-bg: #1a1a1a;
  }

  body {
    color: var(--fg);
    background-color: var(--bg);
  }

  .text-fg { color: var(--fg); }
  .bg-bg { background-color: var(--bg); }
  .text-muted { color: var(--muted); }
  .text-accent { color: var(--accent); }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    color: var(--fg);
  }
  .prose h1 { font-size: 1.5rem; }
  .prose h2 { font-size: 1.25rem; }
  .prose h3 { font-size: 1.125rem; }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--fg);
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--fg);
  }
  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 2px solid var(--fg);
    padding-left: 1rem;
    margin-bottom: 1.25rem;
    font-style: italic;
    color: var(--fg);
  }

  .prose code {
    background: var(--code-bg);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .prose pre {
    background: var(--code-bg);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose a {
    color: var(--accent);
  }

  .prose strong {
    color: var(--fg);
  }

  footer {
    border-color: var(--border) !important;
  }

  @media print {
    header, nav, footer, button#theme-toggle {
      display: none !important;
    }

    body {
      color: #111111;
      background: #ffffff;
      font-size: 12pt;
      line-height: 1.6;
    }

    .max-w-\[65ch\] {
      max-width: none !important;
    }

    body > div {
      max-width: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    a {
      color: #111111;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    a[href^="http"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #666666;
    }

    a[href^="/"]::after {
      content: " (https://nabilalkahar.com" attr(href) ")";
      font-size: 0.8em;
      color: #666666;
    }

    code, pre {
      background: #f5f5f5;
      border: 1px solid #e5e5e5;
    }

    pre {
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    hr {
      border-top: 1px solid #cccccc;
    }

    img {
      max-width: 100% !important;
      page-break-inside: avoid;
    }

    h1, h2, h3 {
      page-break-after: avoid;
    }

    p, li, blockquote {
      orphans: 3;
      widows: 3;
    }

    @page {
      margin: 2cm;
    }
  }
</style>
